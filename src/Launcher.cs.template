// Generated by install.ps1. Opens the Claude desktop app with its own data folder
// and gives its windows their own taskbar identity (AppUserModelID) and icon,
// so this account shows up as a separate app next to the normal Claude.
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Management;
using System.Runtime.InteropServices;
using System.Threading;

static class ClaudeLauncher
{
    const string AppId = @"__APP_ID__";
    const string DisplayName = @"__DISPLAY_NAME__";
    const string DataDir = @"__DATA_DIR__";
    const string IconPath = @"__ICON_PATH__";
    const string ClaudeExe = @"__CLAUDE_EXE__";

    [STAThread]
    static int Main(string[] args)
    {
        if (args.Length == 2 && args[0] == "--set-lnk")
        {
            return SetShortcutAppId(args[1]) ? 0 : 1;
        }

        Process.Start(new ProcessStartInfo(ClaudeExe, "--user-data-dir=\"" + DataDir + "\"") { UseShellExecute = true });

        bool isFirst;
        using (new Mutex(true, @"Local\ClaudeLauncher_" + AppId, out isFirst))
        {
            if (isFirst) Watch();
        }
        return 0;
    }

    // Keeps tagging this account's windows until its Claude process exits.
    static void Watch()
    {
        IntPtr bigIcon = LoadImage(IntPtr.Zero, IconPath, 1, 64, 64, 0x10);
        IntPtr smallIcon = LoadImage(IntPtr.Zero, IconPath, 1, 32, 32, 0x10);
        string self = Process.GetCurrentProcess().MainModule.FileName;

        int pid = 0;
        for (int i = 0; i < 120 && pid == 0; i++)
        {
            pid = FindMainPid();
            if (pid == 0) Thread.Sleep(500);
        }
        if (pid == 0) return;

        Process main;
        try { main = Process.GetProcessById(pid); } catch { return; }

        var tagged = new HashSet<IntPtr>();
        while (!main.HasExited)
        {
            foreach (IntPtr hwnd in TopLevelWindows(pid))
            {
                if (!tagged.Contains(hwnd) && SetWindowAppId(hwnd, self)) tagged.Add(hwnd);
                if (SendMessage(hwnd, 0x7F, (IntPtr)1, IntPtr.Zero) != bigIcon)
                {
                    SendMessage(hwnd, 0x80, (IntPtr)1, bigIcon);
                    SendMessage(hwnd, 0x80, IntPtr.Zero, smallIcon);
                }
            }
            Thread.Sleep(800);
        }
    }

    static int FindMainPid()
    {
        string marker = DataDir.ToLowerInvariant();
        using (var searcher = new ManagementObjectSearcher("SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name = 'Claude.exe'"))
        {
            foreach (ManagementObject p in searcher.Get())
            {
                string cmd = ((p["CommandLine"] as string) ?? "").ToLowerInvariant();
                if (cmd.Contains(marker) && !cmd.Contains("--type=")) return Convert.ToInt32(p["ProcessId"]);
            }
        }
        return 0;
    }

    static List<IntPtr> TopLevelWindows(int pid)
    {
        var list = new List<IntPtr>();
        EnumWindows((h, l) =>
        {
            uint wpid;
            GetWindowThreadProcessId(h, out wpid);
            if (wpid == pid && IsWindowVisible(h) && GetWindow(h, 4) == IntPtr.Zero) list.Add(h);
            return true;
        }, IntPtr.Zero);
        return list;
    }

    static bool SetWindowAppId(IntPtr hwnd, string relaunchExe)
    {
        IPropertyStore store;
        Guid iid = typeof(IPropertyStore).GUID;
        if (SHGetPropertyStoreForWindow(hwnd, ref iid, out store) != 0) return false;
        try
        {
            SetString(store, 2, "\"" + relaunchExe + "\"");
            SetString(store, 4, DisplayName);
            SetString(store, 3, IconPath + ",0");
            SetString(store, 5, AppId);
            return true;
        }
        catch { return false; }
        finally { Marshal.ReleaseComObject(store); }
    }

    static bool SetShortcutAppId(string lnkPath)
    {
        IPropertyStore store;
        Guid iid = typeof(IPropertyStore).GUID;
        if (SHGetPropertyStoreFromParsingName(lnkPath, IntPtr.Zero, 2, ref iid, out store) != 0) return false;
        try
        {
            SetString(store, 5, AppId);
            store.Commit();
            return true;
        }
        finally { Marshal.ReleaseComObject(store); }
    }

    // pid 2..5 of PKEY_AppUserModel_*: RelaunchCommand, RelaunchIconResource, RelaunchDisplayNameResource, ID
    static void SetString(IPropertyStore store, uint pid, string value)
    {
        var key = new PropertyKey { fmtid = new Guid("9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3"), pid = pid };
        var pv = new PropVariant { vt = 31, p = Marshal.StringToCoTaskMemUni(value) };
        try { store.SetValue(ref key, ref pv); }
        finally { Marshal.FreeCoTaskMem(pv.p); }
    }

    [StructLayout(LayoutKind.Sequential, Pack = 4)]
    struct PropertyKey { public Guid fmtid; public uint pid; }

    [StructLayout(LayoutKind.Explicit, Size = 24)]
    struct PropVariant { [FieldOffset(0)] public ushort vt; [FieldOffset(8)] public IntPtr p; }

    [ComImport, Guid("886D8EEB-8CF2-4446-8D02-CDBA1DBDCF99"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    interface IPropertyStore
    {
        void GetCount(out uint c);
        void GetAt(uint i, out PropertyKey k);
        void GetValue(ref PropertyKey k, out PropVariant v);
        void SetValue(ref PropertyKey k, ref PropVariant v);
        void Commit();
    }

    delegate bool EnumProc(IntPtr h, IntPtr l);
    [DllImport("user32.dll")] static extern bool EnumWindows(EnumProc cb, IntPtr l);
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
    [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
    [DllImport("user32.dll")] static extern IntPtr GetWindow(IntPtr h, uint cmd);
    [DllImport("user32.dll")] static extern IntPtr SendMessage(IntPtr h, uint msg, IntPtr w, IntPtr l);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern IntPtr LoadImage(IntPtr inst, string name, uint type, int cx, int cy, uint flags);
    [DllImport("shell32.dll")] static extern int SHGetPropertyStoreForWindow(IntPtr h, ref Guid iid, out IPropertyStore store);
    [DllImport("shell32.dll", CharSet = CharSet.Unicode)] static extern int SHGetPropertyStoreFromParsingName(string path, IntPtr bc, int flags, ref Guid iid, out IPropertyStore store);
}
